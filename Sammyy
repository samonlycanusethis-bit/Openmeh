<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CLASSIFIED // SAMMY</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #020503;
  color: #00ff66;
  font-family: monospace;
}

.panel {
  width: 100%;
  max-width: 550px;
  padding: 25px;
  background: #050c07;
  border: 1px solid #00ff66;
  box-shadow: 0 0 25px #004d20;
  animation: appear 1s ease;
}

h1 {
  text-align: center;
  letter-spacing: 6px;
  text-shadow: 0 0 15px #00ff66;
  animation: glitch 3s infinite;
}

.subtitle {
  text-align: center;
  color: #8affb0;
  font-size: 12px;
}

hr {
  border: 0;
  border-top: 1px solid #006b2b;
  margin: 22px 0;
}

.status {
  color: #00ff66;
  font-weight: bold;
}

.terminal {
  min-height: 180px;
  margin-top: 20px;
  padding: 15px;
  background: #000;
  border: 1px solid #006b2b;
  font-size: 12px;
  line-height: 1.9;
  overflow-wrap: anywhere;
  box-shadow: inset 0 0 12px #001c09;
}

.progress-box {
  width: 100%;
  height: 9px;
  margin-top: 15px;
  background: #102015;
  border: 1px solid #006b2b;
  display: none;
}

.progress {
  height: 100%;
  width: 0%;
  background: #00ff66;
  box-shadow: 0 0 10px #00ff66;
  transition: width 0.3s;
}

button {
  width: 100%;
  margin-top: 18px;
  padding: 14px;
  border: 1px solid #00ff66;
  background: #00ff66;
  color: #001a08;
  font-family: monospace;
  font-weight: bold;
  letter-spacing: 2px;
  cursor: pointer;
}

button:hover {
  background: #aaffc6;
  box-shadow: 0 0 18px #00ff66;
}

button:disabled {
  opacity: 0.7;
  cursor: wait;
}

.warning {
  margin-top: 22px;
  color: #6ca982;
  font-size: 10px;
  line-height: 1.8;
  text-align: center;
}

#cursor {
  animation: blink 0.8s infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes glitch {
  0%, 95%, 100% { transform: translateX(0); }
  96% { transform: translateX(2px); }
  98% { transform: translateX(-2px); }
}
</style>
</head>

<body>

<div class="panel">
  <h1>CLASSIFIED</h1>
  <p class="subtitle">[ SAMMY TERMINAL // VERSION 3.0 ]</p>

  <hr>

  <p>SUBJECT: <span class="status">UNKNOWN</span></p>
  <p>SECURITY: <span class="status">ACTIVE</span></p>
  <p>SCAN STATUS: <span class="status" id="scanStatus">STANDBY</span></p>

  <div class="terminal" id="terminal">
    &gt; Terminal initialized.<br>
    &gt; Secure simulation loaded.<br>
    &gt; Awaiting command<span id="cursor">_</span>
  </div>

  <div class="progress-box" id="progressBox">
    <div class="progress" id="progress"></div>
  </div>

  <button id="scanButton" onclick="startScan()">
    [ SCAN FILES ]
  </button>

  <p class="warning">
    FICTIONAL TERMINAL SIMULATION<br>
    NO REAL FILE ACCESS • NO DATA COLLECTION
  </p>
</div>

<script>
const terminal = document.getElementById("terminal");
const button = document.getElementById("scanButton");
const status = document.getElementById("scanStatus");
const progressBox = document.getElementById("progressBox");
const progress = document.getElementById("progress");

let running = false;

function startScan() {
  if (running) return;
  running = true;

  button.disabled = true;
  button.textContent = "[ SCANNING... ]";
  status.textContent = "RUNNING";
  progressBox.style.display = "block";
  progress.style.width = "0%";

  terminal.innerHTML = "&gt; Starting simulated scan...<br>";

  const files = [
    "profile_data.fake",
    "documents_demo.fake",
    "gallery_scan.fake",
    "system_status.fake",
    "personal_files_simulated.fake",
    "security_report.fake"
  ];

  let i = 0;

  const timer = setInterval(() => {
    if (i < files.length) {
      terminal.innerHTML +=
        "&gt; Scanning " + files[i] +
        " ... SIMULATED<br>";

      progress.style.width =
        Math.round(((i + 1) / files.length) * 100) + "%";

      terminal.scrollTop = terminal.scrollHeight;
      i++;
    } else {
      clearInterval(timer);

      terminal.innerHTML +=
        "<br>&gt; SIMULATION COMPLETE<br>" +
        "&gt; Real files accessed: 0<br>" +
        "&gt; Personal data collected: NONE<br><br>" +
        "&gt; GET DOXXED BY SAMMY 💀";

      status.textContent = "COMPLETE";
      button.disabled = false;
      button.textContent = "[ SCAN AGAIN ]";
      running = false;
    }
  }, 900);
}
</script>

</body>
</html>
